%YAML 1.2
---
name: JavaScript
file_extensions: [js, jsx, mjs, cjs]
scope: source.js
contexts:
  main:
    - match: '/\*'
      push: block-comment
    - match: '//.*$'
      scope: comment.line.javascript
    - match: '"'
      push: double-string
    - match: "'"
      push: single-string
    - match: '\b(?:0[xX][0-9a-fA-F]+|[0-9]+(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)\b'
      scope: constant.numeric.javascript
    - match: '\b(?:async|await|break|case|catch|class|const|continue|debugger|default|delete|do|else|export|extends|finally|for|from|function|get|if|import|in|instanceof|let|new|of|return|set|static|super|switch|this|throw|try|typeof|var|void|while|with|yield|true|false|null|undefined)\b'
      scope: keyword.control.javascript
  double-string:
    - meta_scope: string.quoted.double.javascript
    - match: '\\.'
      scope: constant.character.escape.javascript
    - match: '"'
      pop: true
  single-string:
    - meta_scope: string.quoted.single.javascript
    - match: '\\.'
      scope: constant.character.escape.javascript
    - match: "'"
      pop: true
  block-comment:
    - meta_scope: comment.block.javascript
    - match: '\*/'
      pop: true
