%YAML 1.2
---
name: Go
file_extensions: [go]
scope: source.go
contexts:
  main:
    - match: '/\*'
      push: block-comment
    - match: '//.*$'
      scope: comment.line.go
    - match: '"'
      push: double-string
    - match: ''''
      push: single-string
    - match: '\b(?:0[xX][0-9a-fA-F]+|[0-9]+(?:\.[0-9]+)?)\b'
      scope: constant.numeric.go
    - match: '\b(?:package|import|func|return|defer|go|select|chan|map|struct|interface|type|var|const|if|else|switch|case|default|for|range|break|continue|fallthrough|goto)\b'
      scope: keyword.control.go
    - match: '\b(?:true|false|nil|iota)\b'
      scope: constant.language.go
  double-string:
    - meta_scope: string.quoted.go
    - match: '\\.'
      scope: constant.character.escape.go
    - match: '"'
      pop: true
  single-string:
    - meta_scope: string.quoted.go
    - match: '\\.'
      scope: constant.character.escape.go
    - match: ''''
      pop: true
  block-comment:
    - meta_scope: comment.block.go
    - match: '\*/'
      pop: true
