%YAML 1.2
---
name: PowerShell
file_extensions: [ps1, psm1, psd1]
scope: source.powershell
contexts:
  main:
    - match: '<#'
      push: block-comment
    - match: '#.*$'
      scope: comment.line.powershell
    - match: '"'
      push: double-string
    - match: ''''
      push: single-string
    - match: '\b(?:0[xX][0-9a-fA-F]+|[0-9]+(?:\.[0-9]+)?)\b'
      scope: constant.numeric.powershell
    - match: '\b(?:begin|break|catch|class|continue|data|do|dynamicparam|else|elseif|end|enum|exit|filter|finally|for|foreach|from|function|hidden|if|in|param|process|return|switch|throw|trap|try|until|using|var|while|workflow)\b'
      scope: keyword.control.powershell
    - match: '\$(?:true|false|null)\b'
      scope: constant.language.powershell
  double-string:
    - meta_scope: string.quoted.powershell
    - match: '\\.'
      scope: constant.character.escape.powershell
    - match: '"'
      pop: true
  single-string:
    - meta_scope: string.quoted.powershell
    - match: '\\.'
      scope: constant.character.escape.powershell
    - match: ''''
      pop: true
  block-comment:
    - meta_scope: comment.block.powershell
    - match: '#>'
      pop: true
