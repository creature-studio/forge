%YAML 1.2
---
name: Lua
file_extensions: [lua]
scope: source.lua
contexts:
  main:
    - match: '--\[\['
      push: block-comment
    - match: '--[^\[].*$'
      scope: comment.line.lua
    - match: '"'
      push: double-string
    - match: ''''
      push: single-string
    - match: '\b(?:0[xX][0-9a-fA-F]+|[0-9]+(?:\.[0-9]+)?)\b'
      scope: constant.numeric.lua
    - match: '\b(?:and|break|do|else|elseif|end|false|for|function|goto|if|in|local|nil|not|or|repeat|return|then|true|until|while)\b'
      scope: keyword.control.lua
    - match: '\b(?:true|false|nil)\b'
      scope: constant.language.lua
  double-string:
    - meta_scope: string.quoted.lua
    - match: '\\.'
      scope: constant.character.escape.lua
    - match: '"'
      pop: true
  single-string:
    - meta_scope: string.quoted.lua
    - match: '\\.'
      scope: constant.character.escape.lua
    - match: ''''
      pop: true
  block-comment:
    - meta_scope: comment.block.lua
    - match: '\]\]'
      pop: true
