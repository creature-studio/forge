%YAML 1.2
---
name: PHP
file_extensions: [php, phtml]
scope: source.php
contexts:
  main:
    - match: '/\*'
      push: block-comment
    - match: '(?://|#).*$'
      scope: comment.line.php
    - match: '"'
      push: double-string
    - match: ''''
      push: single-string
    - match: '\b(?:0[xX][0-9a-fA-F]+|[0-9]+(?:\.[0-9]+)?)\b'
      scope: constant.numeric.php
    - match: '\b(?:abstract|and|array|as|break|callable|case|catch|class|clone|const|continue|declare|default|do|echo|else|elseif|empty|enddeclare|endfor|endforeach|endif|endswitch|endwhile|eval|exit|extends|final|finally|fn|for|foreach|function|global|goto|if|implements|include|include_once|instanceof|insteadof|interface|isset|list|match|namespace|new|or|print|private|protected|public|readonly|require|require_once|return|static|switch|throw|trait|try|unset|use|var|while|xor|yield)\b'
      scope: keyword.control.php
    - match: '\b(?:true|false|null)\b'
      scope: constant.language.php
  double-string:
    - meta_scope: string.quoted.php
    - match: '\\.'
      scope: constant.character.escape.php
    - match: '"'
      pop: true
  single-string:
    - meta_scope: string.quoted.php
    - match: '\\.'
      scope: constant.character.escape.php
    - match: ''''
      pop: true
  block-comment:
    - meta_scope: comment.block.php
    - match: '\*/'
      pop: true
