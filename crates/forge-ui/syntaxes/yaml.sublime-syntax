%YAML 1.2
---
name: YAML
file_extensions: [yaml, yml]
scope: source.yaml
contexts:
  main:
    - match: '#.*$'
      scope: comment.line.yaml
    - match: '"'
      push: double-string
    - match: "'"
      push: single-string
    - match: "^\\s*[-?]?\\s*[\\w.-]+(?=\\s*:)"
      scope: entity.name.tag.yaml
    - match: '\b(?:0[xX][0-9a-fA-F]+|[0-9]+(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)\b'
      scope: constant.numeric.yaml
    - match: '\b(?:true|false|null|yes|no|on|off)\b'
      scope: keyword.control.yaml
  double-string:
    - meta_scope: string.quoted.double.yaml
    - match: '\\.'
      scope: constant.character.escape.yaml
    - match: '"'
      pop: true
  single-string:
    - meta_scope: string.quoted.single.yaml
    - match: '\\.'
      scope: constant.character.escape.yaml
    - match: "'"
      pop: true
