---
interface Props {
  title: string;
  description: string;
  lang?: 'zh-CN' | 'en';
  path?: string;
  kind?: 'home' | 'article';
  hasTranslation?: boolean;
}
import '../styles/main.css';
import seoPages from '../data/seo-pages.json';
import { FORGE_VERSION, FORGE_TAG } from '../utils/version';
import { Terminal, Download, Menu, ArrowUpRight } from '@lucide/astro';

const { title, description, lang = 'zh-CN', path = '/', kind = 'article', hasTranslation = true } = Astro.props;
const english = lang === 'en';
const root = '/forge/';
const canonical = `https://creature-studio.github.io${root}${path.replace(/^\//, '')}`;

const structured = kind === 'home' ? {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Forge TUI',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows',
  softwareVersion: FORGE_VERSION,
  description,
  url: canonical,
  downloadUrl: 'https://github.com/creature-studio/forge/releases/latest',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: 'https://opensource.org/licenses/MIT',
} : {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  url: canonical,
  publisher: {
    '@type': 'Organization',
    name: 'Forge TUI',
    url: 'https://github.com/creature-studio/forge',
  },
};

const zhRoot = root;
const enRoot = `${root}en/`;
const translationPath = english ? (path.replace(/^\/en\//, '/') || '/') : ('/en' + path);
const translatedUrl = 'https://creature-studio.github.io/forge' + (translationPath.startsWith('/') ? translationPath : '/' + translationPath);
const localTranslatedPath = hasTranslation ? translatedUrl.replace('https://creature-studio.github.io', '') : zhRoot;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07090d" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${root}favicon.svg`} />
    <link rel="manifest" href={`${root}site.webmanifest`} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    {hasTranslation && <link rel="alternate" hreflang={english ? 'zh-CN' : 'en'} href={translatedUrl} />}
    {kind === 'home' && <link rel="alternate" hreflang="x-default" href="https://creature-studio.github.io/forge/en/" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://creature-studio.github.io/forge/assets/og-cover.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
  </head>
  <body>
    <a class="skip" href="#main">{english ? 'Skip to content' : '跳到正文'}</a>
    <header class="site-header">
      <div class="shell header-inner">
        <div class="brand-cluster">
          <a href={english ? enRoot : zhRoot} class="wordmark" aria-label="Forge TUI home">
            <span class="brand-mark" aria-hidden="true">
              <Terminal size={17} strokeWidth={2.3} />
            </span>
            <span>Forge TUI</span>
          </a>
          <a href={`${english ? enRoot : zhRoot}releases/`} class="version-pill" aria-label={english ? `Release ${FORGE_TAG}` : `版本 ${FORGE_TAG}`}>
            {FORGE_TAG}
          </a>
        </div>

        <nav class="primary-nav" aria-label={english ? 'Main navigation' : '主导航'}>
          <a href={english ? enRoot : zhRoot} aria-current={path === '/' || path === '/en/' ? 'page' : undefined}>
            {english ? 'Overview' : '概览'}
          </a>
          <a href={`${english ? enRoot : zhRoot}guide/`} aria-current={path.endsWith('/guide/') ? 'page' : undefined}>
            {english ? 'Guide' : '操作文档'}
          </a>
          <a href={`${english ? enRoot : zhRoot}releases/`} aria-current={path.endsWith('/releases/') ? 'page' : undefined}>
            {english ? 'Releases' : '发布说明'}
          </a>
          <a href="https://github.com/creature-studio/forge/issues">
            {english ? 'Issues' : '反馈'}
          </a>
        </nav>

        <div class="header-actions">
          <a class="icon-btn-link" href="https://github.com/creature-studio/forge" aria-label="GitHub repository">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor">
              <path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.13c-3.09.67-3.74-1.32-3.74-1.32-.5-1.28-1.23-1.62-1.23-1.62-1.01-.7.08-.68.08-.68 1.12.08 1.7 1.14 1.7 1.14.99 1.7 2.59 1.21 3.22.93.1-.72.39-1.21.71-1.49-2.47-.28-5.06-1.24-5.06-5.49 0-1.21.43-2.19 1.14-2.97-.12-.28-.49-1.41.1-2.94 0 0 .93-.3 3.05 1.13a10.6 10.6 0 0 1 5.55 0c2.12-1.43 3.05-1.13 3.05-1.13.59 1.53.22 2.66.1 2.94.71.78 1.14 1.76 1.14 2.97 0 4.26-2.59 5.2-5.07 5.48.4.35.76 1.02.76 2.06V22c0 .3.2.65.76.54A11.1 11.1 0 0 0 12 .9Z"/>
            </svg>
            <span>GitHub</span>
            <ArrowUpRight size={13} strokeWidth={1.9} aria-hidden="true" />
          </a>
          <a class="lang-switch" href={localTranslatedPath} lang={english ? 'zh-CN' : 'en'}>
            {english ? '中文' : 'EN'}
          </a>
          <a class="btn btn-primary btn-nav" href="https://github.com/creature-studio/forge/releases/latest">
            <Download size={14} strokeWidth={2.2} aria-hidden="true" />
            <span>{english ? 'Download' : '下载'}</span>
          </a>
          <details class="mobile-nav">
            <summary aria-label={english ? 'Open menu' : '打开菜单'}>
              <Menu size={19} />
            </summary>
            <nav aria-label={english ? 'Mobile navigation' : '移动导航'}>
              <a href={english ? enRoot : zhRoot}>{english ? 'Overview' : '概览'}</a>
              <a href={`${english ? enRoot : zhRoot}guide/`}>{english ? 'Guide' : '操作文档'}</a>
              <a href={`${english ? enRoot : zhRoot}releases/`}>{english ? 'Releases' : '发布说明'}</a>
              <a href="https://github.com/creature-studio/forge">{english ? 'GitHub Repository' : 'GitHub 仓库'}</a>
              <a href="https://github.com/creature-studio/forge/issues">{english ? 'Community & Issues' : '社区与反馈'}</a>
              <a href={localTranslatedPath} lang={english ? 'zh-CN' : 'en'}>{english ? '切换到中文' : 'Switch to English'}</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="shell footer-inner">
        <div class="footer-brand">
          <strong>Forge TUI</strong>
          <span class="footer-sep">·</span>
          <span>{english ? `Rust TUI Workspace · ${FORGE_TAG} · MIT License` : `原生 Rust 终端工作台 · ${FORGE_TAG} · MIT 开源协议`}</span>
        </div>
        <div class="footer-links">
          <a href={`${english ? enRoot : zhRoot}guide/`}>{english ? 'Documentation' : '操作文档'}</a>
          <a href={`${english ? enRoot : zhRoot}releases/`}>{english ? 'Release notes' : '发布说明'}</a>
          <a href="https://github.com/creature-studio/forge">GitHub</a>
          <a href="https://github.com/creature-studio/forge/issues">{english ? 'Issues' : '问题反馈'}</a>
        </div>
      </div>
      <nav class="shell seo-links" aria-label={english ? 'Features and workflows' : '功能与使用场景（英文）'}>
        <strong>{english ? 'Features, comparisons & workflows' : '功能与使用场景（英文）'}</strong>
        {seoPages.map(page => <a href={root + 'en/' + page.slug + '/'} lang="en">{page.title}</a>)}
      </nav>
    </footer>

    <script>
      document.addEventListener('click', (event) => {
        const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav[open]');
        if (menu && event.target instanceof Node && !menu.contains(event.target)) {
          menu.open = false;
        }
      });
    </script>
  </body>
</html>

<style>
.seo-links { display:flex; flex-wrap:wrap; gap:.5rem 1.25rem; padding-block:1rem 1.5rem; font-size:.85rem; }
.seo-links strong { flex-basis:100%; }
.seo-links a { text-decoration:underline; text-underline-offset:3px; }
</style>
