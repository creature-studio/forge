---
interface Props {
  title: string;
  description: string;
  lang?: 'zh-CN' | 'en';
  path?: string;
  kind?: 'home' | 'article';
}
import '../styles/main.css';
const { title, description, lang = 'zh-CN', path = '/', kind = 'article' } = Astro.props;
const english = lang === 'en';
const root = '/forge/';
const canonical = `https://creature-studio.github.io${root}${path.replace(/^\//, '')}`;
const structured = kind === 'home' ? {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication',
  name: 'Forge', applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows (via WSL)', softwareVersion: '0.3.0',
  description, url: canonical,
  downloadUrl: 'https://github.com/creature-studio/forge/releases/latest',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: 'https://opensource.org/licenses/MIT',
} : { '@context': 'https://schema.org', '@type': 'TechArticle', headline: title, description, url: canonical,
  publisher: { '@type': 'Organization', name: 'Forge', url: 'https://github.com/creature-studio/forge' } };
const zhRoot = root;
const enRoot = `${root}en/`;
const translationPath = english ? (path.replace(/^\/en\//, '/') || '/') : ('/en' + path);
const translatedUrl = 'https://creature-studio.github.io/forge' + (translationPath.startsWith('/') ? translationPath : '/' + translationPath);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${root}favicon.svg`} />
    <link rel="manifest" href={`${root}site.webmanifest`} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={english ? 'zh-CN' : 'en'} href={translatedUrl} />
    {kind === 'home' && <link rel="alternate" hreflang="x-default" href="https://creature-studio.github.io/forge/en/" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://creature-studio.github.io/forge/assets/og-cover.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
  </head>
  <body>
    <a class="skip" href="#main">{english ? 'Skip to content' : '跳到正文'}</a>
    <header class="header">
      <div class="shell header-inner">
        <a href={english ? enRoot : zhRoot} class="wordmark" aria-label="Forge home"><span class="logo-mark" aria-hidden="true">›_</span><span>Forge</span></a>
        <nav class="nav" aria-label={english ? 'Main navigation' : '主导航'}>
          <a href={english ? enRoot : zhRoot}>{english ? 'Home' : '首页'}</a>
          <a href={`${english ? enRoot : zhRoot}guide/`}>{english ? 'Docs' : '操作文档'}</a>
          <a href={`${english ? enRoot : zhRoot}releases/`}>{english ? 'Releases' : '发布说明'}</a>
          <a href="https://github.com/creature-studio/forge/issues">{english ? 'Community' : '社区'}</a>
        </nav>
        <div class="header-actions">
          <a class="github-link" href="https://github.com/creature-studio/forge" aria-label="GitHub"><svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" fill="currentColor"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.13c-3.09.67-3.74-1.32-3.74-1.32-.5-1.28-1.23-1.62-1.23-1.62-1.01-.7.08-.68.08-.68 1.12.08 1.7 1.14 1.7 1.14.99 1.7 2.59 1.21 3.22.93.1-.72.39-1.21.71-1.49-2.47-.28-5.06-1.24-5.06-5.49 0-1.21.43-2.19 1.14-2.97-.12-.28-.49-1.41.1-2.94 0 0 .93-.3 3.05 1.13a10.6 10.6 0 0 1 5.55 0c2.12-1.43 3.05-1.13 3.05-1.13.59 1.53.22 2.66.1 2.94.71.78 1.14 1.76 1.14 2.97 0 4.26-2.59 5.2-5.07 5.48.4.35.76 1.02.76 2.06V22c0 .3.2.65.76.54A11.1 11.1 0 0 0 12 .9Z"/></svg><span>GitHub</span></a>
          <a class="lang-link" href={translatedUrl.replace('https://creature-studio.github.io', '')} lang={english ? 'zh-CN' : 'en'}>{english ? '中文' : 'EN'}</a>
          <a class="btn btn-primary download-nav" href="https://github.com/creature-studio/forge/releases/latest">{english ? 'Download' : '下载'} <span>v0.3.0</span></a>
        </div>
      </div>
    </header>
    <slot />
    <footer class="footer"><div class="shell footer-inner"><span>© 2026 Forge · MIT License</span><div><a href={`${english ? enRoot : zhRoot}guide/`}>{english ? 'Documentation' : '操作文档'}</a><a href={`${english ? enRoot : zhRoot}releases/`}>{english ? 'Release notes' : '发布说明'}</a><a href="https://github.com/creature-studio/forge">GitHub</a></div></div></footer>
  </body>
</html>
