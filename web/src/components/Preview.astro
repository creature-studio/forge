---
import { GitBranch } from '@lucide/astro';
---
<div class="terminal-shot" aria-label="Forge terminal screenshot">
  <div class="terminal-toolbar" aria-hidden="true">
    <span class="traffic-dots"><i></i><i></i><i></i></span>
    <span class="terminal-toolbar-title">Forge — ~/projects/forge</span>
    <span class="terminal-toolbar-branch"><GitBranch size={13} strokeWidth={1.7}/> main</span>
  </div>
  <picture>
    <source srcset="/forge/assets/forge-diff-900.webp 900w, /forge/assets/forge-diff-1800.webp 1800w" sizes="(max-width: 960px) 100vw, 55vw" type="image/webp" />
    <img src="/forge/assets/forge-diff.png" width="1800" height="882" alt="Forge 真实 TUI 界面：文件目录树和并排 Git 差异对比" decoding="async" fetchpriority="high" />
  </picture>
</div>
