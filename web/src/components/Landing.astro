---
import Preview from './Preview.astro';
import faqZh from '../legacy/faq-zh.html?raw';
import { Download, BookOpen, FolderOpen, GitBranch, Search, CodeXml, Zap, ArrowUpRight, ChevronRight, ArrowRight, Monitor, Apple, Terminal, Keyboard, FileCode, CircleCheck, Clock, GitCompareArrows } from '@lucide/astro';
const { english = false } = Astro.props;
const base = english ? '/forge/en/' : '/forge/';
const data = english ? {
  eyebrow:'OPEN SOURCE · RUST TUI',headline:'A refined terminal workspace',
  description:'Browse files, edit source, review changes and manage Git in one focused terminal interface. Fast, lightweight and designed for developers.',
  download:'Get Forge v0.3.2',guide:'Explore docs',
  features:[['File management','Browse, preview and edit with ease'],['Git workflow','Diff · Commit · Stash · History'],['Smart search','Find files and source instantly'],['Code insights','Git Blame · Change Peek · Focus'],['Lightweight','Native Rust, fast to launch']],
  start:'Quick start',startDesc:'From installation to your first review in three steps.',
  steps:[['Install Forge','Download and add to your PATH'],['Open your project','Run forge /path/to/project'],['Start working','Browse, edit, search and review Git changes']],
  docs:'Documentation',docsDesc:'A practical guide to the tools and shortcuts.',
  docRows:[['Quick start','Install, launch and basic usage','what-is-forge'],['Core features','File tree, editing, search and Git','workflow'],['Git workflow','Review changes, stage and commit','workflow'],['Shortcuts & settings','Keyboard reference and preferences','questions']],
  full:'Browse all docs',release:'What’s new in v0.3.2',releaseDesc:'Workspace switching, faster refreshes and a more robust terminal.',releaseLink:'Read release notes',
  faq:'Frequently asked questions',faqIntro:'Answers to common questions about Forge.',
} : {
  eyebrow:'OPEN SOURCE · RUST TUI',headline:'高效、专注的终端开发工具',
  description:'现代化的 TUI 文件与 Git 工作台。集文件浏览、代码编辑、Git 全流程、搜索与变更预览于一体，让终端开发同样高效、优雅、可控。',
  download:'立即下载 v0.3.2',guide:'查看文档',
  features:[['文件管理','快速浏览与定位项目文件'],['Git 全流程','Diff · Commit · Stash · History'],['智能搜索','项目搜索与文件内搜索'],['代码洞察','Git Blame · 变更预览 · 关注点'],['轻量高效','Rust 构建，启动快，资源占用低']],
  start:'快速上手',startDesc:'从安装到上手，只需要三个步骤。',
  steps:[['安装 Forge','下载并添加到 PATH'],['打开项目','forge /path/to/project'],['开始使用','浏览文件、编辑代码、查看 Git 变更']],
  docs:'文档导航',docsDesc:'快速找到对应功能的使用说明。',
  docRows:[['快速开始','安装、启动与基本使用','install'],['核心功能','文件管理、编辑、搜索、Git 工作流','files'],['Git 工作流','变更预览、暂存与提交','git'],['快捷键与设置','完整快捷键与操作说明','settings']],
  full:'查看完整文档',release:'v0.3.2 更新说明',releaseDesc:'Workspace 快速切换、异步刷新优化和 Terminal 稳定性提升。',releaseLink:'查看发布说明',
  faq:'常见问题',faqIntro:'关于安装、Git 工作流、字体与配置。',
};
const featureIcons = [FolderOpen, GitBranch, Search, CodeXml, Zap];
const docsIcons = [BookOpen, FileCode, GitCompareArrows, Keyboard];
---
<main id="main" class="landing-green">
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="hero-eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>{data.eyebrow}</div>
        <h1 id="hero-title">Forge</h1>
        <h2>{data.headline}</h2>
        <p class="summary">{data.description}</p>
        <div class="actions">
          <a class="btn btn-primary hero-download" href="https://github.com/creature-studio/forge/releases/latest"><Download size={19} strokeWidth={2} aria-hidden="true" />{data.download}</a>
          <a class="btn btn-secondary hero-docs" href={`${base}guide/`}><BookOpen size={19} strokeWidth={1.9} aria-hidden="true" />{data.guide}</a>
        </div>
        <div class="hero-meta" aria-label={english ? 'Supported platforms' : '支持的平台'}>
          <span><Monitor size={15} aria-hidden="true" />Windows · WSL</span>
          <span><Apple size={15} aria-hidden="true" />macOS</span>
          <span><Terminal size={15} aria-hidden="true" />Linux</span>
          <i aria-hidden="true"></i><span><CircleCheck size={15} aria-hidden="true" />Rust · MIT</span>
        </div>
      </div>
      <Preview />
    </div>
  </section>
  <section class="highlights" aria-label={english ? 'Core features' : '核心功能'}>
    <div class="shell highlight-grid">
      {data.features.map(([title, description],i) => {
        const Icon = featureIcons[i];
        return <div class="highlight"><Icon size={28} strokeWidth={1.9} aria-hidden="true"/><h3>{title}</h3><p>{description}</p></div>
      })}
    </div>
  </section>
  <section class="resources shell" aria-label={english ? 'Get started and documentation' : '快速开始与文档导航'}>
    <div class="resources-grid">
      <article class="resource resource-card quickstart-card">
        <div class="resource-heading"><div><span class="card-overline">01 / GET STARTED</span><h2>{data.start}</h2></div><Terminal size={23} strokeWidth={1.9} class="card-heading-icon" aria-hidden="true" /></div>
        <p>{data.startDesc}</p>
        <ol class="quick-steps">
          {data.steps.map(([title, description],i) => <li><span class="step-number">{i+1}</span><strong>{title}</strong><span class="step-description">{description}</span></li>)}
        </ol>
        <a class="card-bottom-link" href={`${base}guide/#${english?'what-is-forge':'install'}`}>{data.full}<ArrowRight size={16} aria-hidden="true" /></a>
      </article>
      <article class="resource resource-card doc-card">
        <div class="resource-heading"><div><span class="card-overline">02 / DOCUMENTATION</span><h2>{data.docs}</h2></div><BookOpen size={23} strokeWidth={1.9} class="card-heading-icon" aria-hidden="true" /></div>
        <p>{data.docsDesc}</p>
        <div class="doc-links">
          {data.docRows.map(([title, description, anchor],i) => {
            const Icon=docsIcons[i];
            return <a class="doc-link-row" href={`${base}guide/#${anchor}`}><Icon size={18} strokeWidth={1.9} class="doc-row-icon" aria-hidden="true" /><span class="doc-link-title">{title}</span><span class="doc-link-summary">{description}</span><ChevronRight size={17} strokeWidth={1.9} aria-hidden="true" /></a>
          })}
        </div>
      </article>
    </div>
    <a class="release-note-strip" href={`${base}releases/#v030`}>
      <span class="release-badge"><Clock size={16} strokeWidth={1.9} aria-hidden="true" />v0.3.2</span>
      <span class="release-headline">{data.release}</span>
      <span class="release-excerpt">{data.releaseDesc}</span>
      <span class="release-more">{data.releaseLink}<ArrowUpRight size={16} aria-hidden="true" /></span>
    </a>
  </section>
  {!english && <section class="faq shell" aria-labelledby="faq-title"><div class="faq-heading"><h2 id="faq-title">{data.faq}</h2><p>{data.faqIntro}</p></div><div class="faq-list"><Fragment set:html={faqZh} /></div></section>}
</main>
